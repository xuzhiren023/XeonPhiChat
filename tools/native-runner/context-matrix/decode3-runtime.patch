+++ b/tests/test-knc-performance.py
@@ -0,0 +1,51 @@
+import copy
+import importlib.util
+from pathlib import Path
+import unittest
+
+spec = importlib.util.spec_from_file_location('plan', Path(__file__).resolve().parents[1] / 'examples/knc/performance-plan.py')
+plan = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(plan)
+
+
+class PerformanceReports(unittest.TestCase):
+    def receipt(self):
+        r = dict(kind='native_guarded', profile='7120P', tier='2.6b', context=2048, text_only=True,
+                 correctness_passed=True, affinity_verified=True, guards_passed=True)
+        for key in ('model_sha256','prompt_sha256','baseline_sha256','candidate_sha256'): r[key]='a'*64
+        row = dict(context=2048, prompt_tokens=128, prefill_ms=16000, decode_evals=16, decode_ms=3200)
+        r['baseline']=[copy.deepcopy(row) for _ in range(5)]
+        r['candidate']=[copy.deepcopy(row) for _ in range(5)]
+        return r
+    def test_target_uses_evaluations(self):
+        r=self.receipt()
+        for row in r['candidate']: row['generated_tokens']=1000
+        result=plan.score(r)
+        self.assertEqual(result['rates_tps']['candidate']['decode'],5)
+        self.assertFalse(result['target_met'])
+        for row in r['candidate']: row['decode_ms']=1600
+        result=plan.score(r)
+        self.assertEqual(result['rates_tps']['candidate']['decode'],10)
+        self.assertTrue(result['target_met'])
+    def test_regression(self):
+        r=self.receipt()
+        for row in r['candidate']: row['decode_ms']=4000
+        self.assertTrue(plan.score(r)['regression'])
+        self.assertFalse(plan.score(r)['target_met'])
+    def test_rejections(self):
+        for field,value in (('kind','host_reference'),('guards_passed',False),('correctness_passed',False),('text_only',False)):
+            r=self.receipt();r[field]=value
+            with self.assertRaises(AssertionError): plan.score(r)
+        for key,value in (('decode_evals',7),('context',4096),('profiling',True),('prefill_ms',0)):
+            r=self.receipt();r['candidate'][0][key]=value
+            with self.assertRaises(AssertionError): plan.score(r)
+    def test_all_card_plans(self):
+        for profile,cores in plan.WORKERS.items():
+            p=plan.plan(profile)
+            self.assertFalse(p['executed'])
+            for case in p['stages'][1]['cases']:
+                self.assertIn(case['generation_threads'],[cores*n for n in (2,3,4)])
+                self.assertIn(case['prompt_threads'],[cores*n for n in (2,3,4)])
+
+
+if __name__=='__main__': unittest.main()
