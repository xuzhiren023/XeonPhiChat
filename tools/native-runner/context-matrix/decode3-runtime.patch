+#!/usr/bin/env python3
+"""Host source-instruction checks; requires the pinned BluePower test translators.
+
+Not a native KNC emulator or timing benchmark. All addresses and integer IMCI
+equations from panel-native.S pass through the existing strict instruction shim.
+"""
+import argparse
+import importlib.util
+from pathlib import Path
+import re
+import subprocess
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--bluepower', type=Path, required=True)
+    p.add_argument('--source', type=Path, required=True)
+    p.add_argument('--output', type=Path, required=True)
+    a = p.parse_args()
+    a.output.mkdir()
+    knc = a.source / 'ggml/src/ggml-cpu/arch/knc'
+    ext = a.bluepower / 'native/imci-ext/translate-imci.py'
+    vendor = a.bluepower / 'third-party/knc-gcc-kernels-0.2.1/tests'
+    spec = importlib.util.spec_from_file_location('imci', ext)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    run = lambda cmd: subprocess.run([str(x) for x in cmd], check=True)
+    run(['python3', knc / 'panel.py', knc / 'quant-native.S', a.output / 'panel.S'])
+    (a.output / 'candidate-config.h').write_text('#define GGML_KNC_MQ_L1 8\n#define GGML_KNC_MQ_L2 32\n')
+    asm = subprocess.check_output(['gcc', '-E', '-P', '-x', 'assembler-with-cpp', '-D__k1om__', '-D__KNC__',
+                                   str(a.output / 'panel.S')], text=True)
+    generated = ['#include "imci-test-shim.h"']
+    for mask in (1, 3, 4, 15, 32):
+        generated.append(f'static const uint32_t Lmask{mask} = {mask};')
+    for q in (3, 4, 5, 6):
+        body = asm.split(f'ggml_knc_q{q}_panel_native:\n')[1].split('.size')[0]
+        generated += [f'void ggml_knc_q{q}_panel_native(const uint8_t *lo, const uint8_t *hi, const int8_t *y,',
+                      ' const int32_t *sc, int32_t *out, const uint8_t *x, size_t remaining) {',
+                      'uintptr_t g[16]={0}, model_stack[2]={0, remaining};',
+                      'g[7]=(uintptr_t)lo; g[6]=(uintptr_t)hi; g[2]=(uintptr_t)y; g[1]=(uintptr_t)sc;',
+                      'g[8]=(uintptr_t)out; g[9]=(uintptr_t)x; g[4]=(uintptr_t)model_stack;',
+                      'model_vector z[32]; unsigned lane; uintptr_t left=0, right=0; memset(z,0xa5,sizeof(z));']
+        for line in body.splitlines():
+            line = line.strip()
+            if line:
+                generated.append(line[1:]+';' if line.endswith(':') else mod.instruction(line))
+        generated.append('}')
+    (a.output / 'panel.c').write_text('\n'.join(generated))
+    run(['python3', ext, '--profile', '7120P', knc / 'quant-native.S', a.output / 'ext.c'])
+    run(['python3', vendor / 'translate-imci.py', '--profile', '7120P', knc / 'ggml-knc-native.S', a.output / 'q5.c'])
+    test = (a.bluepower / 'tests/native/multi-quant/test-staging.c').read_text()
+    test = test.replace('activation_bytes = nb*292;', 'activation_bytes = 4*nb*292;')
+    test = test.replace('b < nb; ++b) {\n                uint8_t * c = y+b*292;', 'b < 4*nb; ++b) {\n                uint8_t * c = y+b*292;')
+    start = test.index('            actual[0] = actual[nr+1]')
+    end = test.index('            free(u); free(v);', start)
+    test = test[:start] + '''
+            float panel[4][10];
+            for (int c = 0; c < 4; ++c) for (int r = 0; r < 10; ++r) panel[c][r] = 12345.0f;
+            staged = 0;
+            ggml_knc_mq_panel(q, nb, nr, x, stride, y, nb*292, &panel[0][1], 10);
+            assert(staged == (size_t) 4*nb);
+            for (int c = 0; c < 4; ++c) {
+                assert(panel[c][0] == 12345.0f);
+                for (int r = nr+1; r < 10; ++r) assert(panel[c][r] == 12345.0f);
+                ggml_knc_mq_kernel(q)(nb, nr, x, stride, y+c*nb*292, actual);
+                for (int r = 0; r < nr; ++r) {
+                    float oracle = 0;
+                    for (int b = 0; b < nb; ++b) {
+                        int32_t dot = 0;
+                        for (int i = 0; i < 256; ++i)
+                            dot += value(x+r*stride+b*strides[q], q, i)*signed_byte(y[(c*nb+b)*292+4+i]);
+                        oracle += (float)dot;
+                    }
+                    if (panel[c][r+1] != oracle || memcmp(&panel[c][r+1], &actual[r], 4)) {
+                        fprintf(stderr, "FAIL panel q%d off=%d nb=%d nr=%d col=%d row=%d got=%g oracle=%g old=%g\\n",
+                                q, off, nb, nr, c, r, panel[c][r+1], oracle, actual[r]);
+                        return 1;
+                    }
+                    ++checks;
+                }
+            }
+            // Nontrivial FP16 metadata and FP32 activation factors must preserve
+            // the established complete-block rounding, including subnormals.
+            for (int r = 0; r < nr; ++r) for (int b = 0; b < nb; ++b) {
+                uint8_t *a = x+r*stride+b*strides[q];
+                const uint16_t half[] = {1, 0x2345, 0x9abc, 0x3c01, 0x7bff};
+                int pos = q == 3 ? 108 : q == 6 ? 208 : 0;
+                uint16_t d = half[(b+r)%5];
+                a[pos] = d & 255; a[pos+1] = d >> 8;
+                if (q == 4 || q == 5) { a[2] = 0x23; a[3] = 0x12; }
+            }
+            for (int b = 0; b < 4*nb; ++b) {
+                float scale = 0.00731f * (1+b%7);
+                memcpy(y+b*292, &scale, 4);
+            }
+            ggml_knc_mq_panel(q, nb, nr, x, stride, y, nb*292, &panel[0][1], 10);
+            for (int c = 0; c < 4; ++c) {
+                ggml_knc_mq_kernel(q)(nb, nr, x, stride, y+c*nb*292, actual);
+                for (int r = 0; r < nr; ++r) {
+                    if (memcmp(&panel[c][r+1], &actual[r], 4)) {
+                        fprintf(stderr, "FAIL scaled panel q%d off=%d nb=%d nr=%d c=%d r=%d\\n",q,off,nb,nr,c,r);
+                        return 1;
+                    }
+                    ++checks;
+                }
+            }
+''' + test[end:]
+    (a.output / 'test.c').write_text(test.replace('staging once per block per tile', 'four-column panel'))
+    run(['gcc', '-std=c11', '-O1', '-g', '-fno-fast-math', '-fsanitize=address,undefined',
+         '-fno-omit-frame-pointer', '-no-pie', '-DGGML_KNC_TEST_EMULATION', '-DGGML_KNC_TEST_PREFETCH_TRACE',
+         '-DGGML_KNC_MQ_TEST_STAGING', '-I'+str(knc), '-I'+str(vendor), knc / 'knc-mq.c',
+         a.output / 'test.c', a.output / 'ext.c', a.output / 'q5.c', a.output / 'panel.c', '-lm', '-o', a.output / 'test'])
+    run([a.output / 'test'])
+
+
+if __name__ == '__main__':
+    main()
