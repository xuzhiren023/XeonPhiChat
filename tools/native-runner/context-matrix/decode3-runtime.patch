@@ -0,0 +1,84 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: MIT
+"""Generate four-column IMCI blocks from the established integer equations."""
+import re
+import sys
+from pathlib import Path
+
+
+def body(bits, source):
+    if bits == 5:
+        lines = ["vpbroadcastd .Lmask15(%rip), %zmm7", "vpbroadcastd .Lmask1(%rip), %zmm5"]
+        for j in range(16):
+            lines += [
+                f"vmovdqa32 {32*(j//4)+16*(j%2)}(%rdi){{uint8}}, %zmm9",
+                f"vpsrld ${4*((j%4)//2)}, %zmm9, %zmm9",
+                "vpandd %zmm7, %zmm9, %zmm9",
+                f"vmovdqa32 {16*(j%2)}(%rsi){{uint8}}, %zmm10",
+                f"vpsrld ${j//2}, %zmm10, %zmm10",
+                "vpandd %zmm5, %zmm10, %zmm10",
+                "vpslld $4, %zmm10, %zmm10",
+                "vpord %zmm10, %zmm9, %zmm9",
+                "vcvtfxpntdq2ps $0, %zmm9, %zmm9",
+                f"vcvtfxpntdq2ps $0, {4*(j//2)}(%rcx){{1to16}}, %zmm10",
+                "vmulps %zmm10, %zmm9, %zmm9",
+                f"vmovaps {16*j}(%rdx){{sint8}}, %zmm11",
+                f"vfmadd231ps %zmm11, %zmm9, %zmm{j%4}",
+            ]
+        return lines
+    text = source.split(f"ggml_knc_q{bits}_block_native:\n", 1)[1].split("\n.size", 1)[0]
+    text = re.sub(r"#ifdef TARGET_KNC_.*?#endif\n", "", text, flags=re.S)
+    return [s for s in text.splitlines() if s.startswith("v") and not s.startswith(("vpxord", "vaddps", "vcvtfxpntps2dq", "vmovdqa32 %"))]
+
+
+def generate(source):
+    out = ["/* SPDX-License-Identifier: MIT; generated by panel.py. */",
+           '#include "candidate-config.h"',
+           "#if !defined(__k1om__) || !defined(__KNC__) || defined(__AVX512F__)",
+           '#error "Native Knights Corner IMCI required"', "#endif", ".text"]
+    for q, stride in ((3, 110), (4, 144), (5, 176), (6, 210)):
+        name = f"ggml_knc_q{q}_panel_native"
+        out += [".p2align 4", f".globl {name}", f".type {name}, @function", name + ":"]
+        # rdi/rsi low/high, rdx four aligned Q8 columns, rcx scales, r8 lanes,
+        # r9 packed weight block; stack argument 7 is remaining blocks.
+        for hint, lead in (("vprefetch0", "GGML_KNC_MQ_L1"), ("vprefetch1", "GGML_KNC_MQ_L2")):
+            label = f".Lpanel{q}_{hint}"
+            out += [f"#if {lead} > 0", "movq 8(%rsp), %r10", f"cmpq $(({lead}+15)/16), %r10",
+                    f"jbe {label}", f"{hint} ((({lead}+15)/16)*{stride})(%r9)", label + ":", "#endif"]
+        for c in range(4):
+            for a in range(4):
+                r = a if c == 0 else 8 + c*4 + a
+                out.append(f"vpxord %zmm{r}, %zmm{r}, %zmm{r}")
+        offset, count = None, 0
+        for line in body(q, source):
+            load = re.fullmatch(r"vmovaps (\d+)\(%rdx\)\{sint8\}, %zmm11", line)
+            if load:
+                offset = int(load[1])
+            elif line.startswith("vfmadd231ps"):
+                assert offset == count*16
+                for c in range(4):
+                    r = count % 4 if c == 0 else 8 + c*4 + count%4
+                    out += [f"vmovaps {offset+c*256}(%rdx){{sint8}}, %zmm11",
+                            f"vfmadd231ps %zmm11, %zmm9, %zmm{r}"]
+                count += 1
+            else:
+                assert not re.search(r"%zmm(?:1[2-9]|2[0-9]|3[01])\b", line), line
+                out.append(line)
+        assert count == 16
+        for c in range(4):
+            a = 0 if c == 0 else 8+c*4
+            out += [f"vaddps %zmm{a+1}, %zmm{a}, %zmm{a}",
+                    f"vaddps %zmm{a+3}, %zmm{a+2}, %zmm{a+2}",
+                    f"vaddps %zmm{a+2}, %zmm{a}, %zmm{a}",
+                    f"vcvtfxpntps2dq $0, %zmm{a}, %zmm{a}",
+                    f"vmovdqa32 %zmm{a}, {c*64}(%r8)"]
+        out += ["ret", f".size {name}, .-{name}"]
+    out += [".section .rodata", ".p2align 2"]
+    for mask in (1, 3, 4, 15, 32):
+        out += [f".Lmask{mask}:", f".long {mask}"]
+    out += ['.section .note.GNU-stack,"",@progbits']
+    return "\n".join(out) + "\n"
+
+
+if __name__ == "__main__":
+    Path(sys.argv[2]).write_text(generate(Path(sys.argv[1]).read_text()))
