+++ b/examples/knc/performance-plan.py
@@ -0,0 +1,75 @@
+#!/usr/bin/env python3
+"""Generate guarded-test cases or score native receipts; never contacts hardware."""
+import argparse
+import json
+from pathlib import Path
+import statistics
+
+WORKERS = {'3120A': 56, '5110P': 59, '7120P': 60}
+TARGETS = {'8b-10b': {'decode_min': 4, 'prefill_min': 4},
+           '2.6b': {'decode_min': 10, 'prefill_min': 8, 'prefill_stretch': 10}}
+
+
+def plan(profile):
+    cores = WORKERS[profile]
+    def case(name, gen=3, prompt=3, rows=4, cols=4, batch=32):
+        return dict(name=name, generation_threads=cores*gen, prompt_threads=cores*prompt,
+                    batch=batch, context=2048, predict=8,
+                    environment={'GGML_KNC_MQ_ROWS':str(rows), 'GGML_KNC_MQ_COLS':str(cols)})
+    screen = [case(f'cols{c}-batch{b}', cols=c, batch=b) for c in (1,4) for b in (32,128)]
+    tune = [case(f'g{g}-p{p}-rows{r}', gen=g, prompt=p, rows=r)
+            for g in (2,3,4) for p in (2,3,4) for r in (2,4,8)]
+    return dict(schema=1, profile=profile, executed=False, targets=TARGETS,
+        requirements=['Matching native KNC, recorded model/runner identities, existing exclusive workload lease',
+                      'Reuse verified identities for local-to-card transfers; successful transport and byte count, no repeated hash scan',
+                      'Existing thermal, memory, heartbeat and Stop guards; verify actual affinity',
+                      'Pass same-input numerical gates before timing; no tracing or operator profiling',
+                      'Count actual input and decode evaluations, not requested output length'],
+        stages=[dict(name='screen', model='small trained fixture', prompt_tokens_about=32, warmups=1, repetitions=2, cases=screen),
+                dict(name='tune', model='small trained fixture', prompt_tokens_about=32, warmups=1, repetitions=2, cases=tune,
+                     note='Use the winning column tile and batch from screen; this stage varies worker counts independently.'),
+                dict(name='confirm', model='each target model and quantization', prompt_tokens_about=128,
+                     predict=32, warmups=1, repetitions=5, order='alternate baseline/candidate',
+                     note='Test the held-out winner; retain raw timings, first-token latency, memory and temperature.'),
+                dict(name='vision', model='small matching decoder/projector', image='same small image plus two distinct crops',
+                     vision_smt=[2,3,4], cache_mib=[0,32,64], image_detail=['full','overview'],
+                     note='Keep vision workers inside the admitted affinity pool. Report cold/hit and detail quality separately.')])
+
+
+def score(data):
+    assert data['kind']=='native_guarded', 'Host/synthetic timings cannot meet native targets'
+    assert data.get('text_only') is True, 'Text targets exclude image preprocessing and image tokens'
+    assert data['profile'] in WORKERS and data['tier'] in TARGETS
+    for field in ('model_sha256','prompt_sha256','baseline_sha256','candidate_sha256'):
+        assert len(data[field])==64 and set(data[field])<=set('0123456789abcdef'), field
+    assert all(data.get(k) is True for k in ('correctness_passed','affinity_verified','guards_passed'))
+    rates={}
+    for mode in ('baseline','candidate'):
+        rows=data[mode]
+        assert len(rows)>=5, 'At least five measured repetitions after warmup'
+        assert all(r['context']==data['context'] and not r.get('profiling',False) for r in rows)
+        assert rows[0]['prompt_tokens']>=64, 'Short screening runs cannot qualify throughput targets'
+        assert all(r['prompt_tokens']==rows[0]['prompt_tokens'] and r['decode_evals']>=16 and
+                   r['prefill_ms']>0 and r['decode_ms']>0 for r in rows)
+        rates[mode]={'prefill':statistics.median(1000*r['prompt_tokens']/r['prefill_ms'] for r in rows),
+                     'decode':statistics.median(1000*r['decode_evals']/r['decode_ms'] for r in rows)}
+    assert data['baseline'][0]['prompt_tokens']==data['candidate'][0]['prompt_tokens']
+    assert [r['decode_evals'] for r in data['baseline']]==[r['decode_evals'] for r in data['candidate']], 'Unequal generation workload'
+    target=TARGETS[data['tier']]
+    return dict(profile=data['profile'],tier=data['tier'],rates_tps=rates,targets=target,
+                target_met=all(rates['candidate'][k]>=target[k+'_min'] for k in ('prefill','decode')),
+                regression=any(rates['candidate'][k]<rates['baseline'][k]*0.97 for k in ('prefill','decode')),
+                change_percent={k:100*(rates['candidate'][k]/rates['baseline'][k]-1) for k in ('prefill','decode')})
+
+
+if __name__=='__main__':
+    if not __debug__:
+        raise RuntimeError('Receipt checks must run without Python -O/PYTHONOPTIMIZE')
+    p=argparse.ArgumentParser(description=__doc__)
+    g=p.add_mutually_exclusive_group(required=True)
+    g.add_argument('--plan',choices=WORKERS)
+    g.add_argument('--score',type=Path)
+    p.add_argument('--output',type=Path,required=True)
+    a=p.parse_args()
+    result=plan(a.plan) if a.plan else score(json.loads(a.score.read_text()))
+    with a.output.open('x') as f: json.dump(result,f,indent=2); f.write('\n')
