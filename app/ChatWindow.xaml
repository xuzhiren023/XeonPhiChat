<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Phi Chat" Width="1180" Height="820" MinWidth="820" MinHeight="560" Background="#212121" Foreground="#ECECEC" FontFamily="Segoe UI">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#ECECEC"/><Setter Property="Background" Value="#212121"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Background="{TemplateBinding Background}" BorderThickness="0" Foreground="{TemplateBinding Foreground}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" Padding="10,8" CornerRadius="8"><DockPanel><TextBlock Text="&#x2304;" DockPanel.Dock="Right" Margin="12,0,0,0" Foreground="#999999"/><ContentPresenter/></DockPanel></Border></ControlTemplate></ToggleButton.Template><DockPanel><TextBlock Text="&#x2713;" DockPanel.Dock="Right" Foreground="#6DDC9F" FontWeight="SemiBold" Margin="8,0,0,0" Visibility="{Binding SelectedItem.optimized, RelativeSource={RelativeSource AncestorType=ComboBox}, Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding SelectedItem.label, RelativeSource={RelativeSource AncestorType=ComboBox}}" TextTrimming="CharacterEllipsis"/></DockPanel></ToggleButton><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#303030" BorderBrush="#454545" BorderThickness="1" CornerRadius="10" Padding="6" MinWidth="300"><ScrollViewer MaxHeight="360"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#ECECEC"/><Setter Property="Background" Value="#303030"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#454545"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,12"/><Setter Property="Margin" Value="0,2"/><Setter Property="Foreground" Value="#DCDCDC"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#303030"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#292929"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid Background="#212121" TextOptions.TextFormattingMode="Display"><Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#171717" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="Phi Chat" FontSize="21" FontWeight="SemiBold" Margin="8,6,0,24"/>
   <Button x:Name="New" Grid.Row="1" Content="+  New chat" HorizontalContentAlignment="Left" Margin="0,0,0,26"/>
   <TextBlock Grid.Row="2" Text="Recent chats" Foreground="#999999" Margin="10,0,0,10" FontSize="12"/>
   <ListBox x:Name="Recent" Grid.Row="3" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><DockPanel><Button DockPanel.Dock="Right" Content="&#x22EF;" Tag="ChatMenu" Padding="5,0" Margin="6,0,-4,0" Background="Transparent" FontSize="18" ToolTip="Rename or delete chat" AutomationProperties.Name="Chat options"/><TextBlock Text="{Binding title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding title}"/></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
   <StackPanel Grid.Row="4"><Button x:Name="Save" Content="Save chat" Background="Transparent" HorizontalAlignment="Left"/><TextBlock x:Name="ConnectionState" Text="Connecting..." Foreground="#999999" FontSize="12" Margin="12,14,0,4"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Column="1" Margin="24,18,24,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,12"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="Load" Content="Load model" Margin="8,0,0,0" IsEnabled="False"/><Button x:Name="Connect" Content="Reconnect" Background="Transparent" Margin="8,0,0,0"/></StackPanel>
    <ComboBox x:Name="Model" MaxWidth="440" HorizontalAlignment="Left" Padding="10,8" FontSize="15" ToolTip="Each chat keeps the model used for its first message."><ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="IsEnabled" Value="{Binding enabled}"/><Setter Property="ToolTip" Value="{Binding hint}"/></Style></ComboBox.ItemContainerStyle><ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding label}"/><TextBlock Text="&#x2713;" Foreground="#6DDC9F" FontWeight="SemiBold" Margin="8,0,0,0" Visibility="{Binding optimized, Converter={StaticResource BoolVisibility}}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
   </DockPanel>
   <StackPanel Grid.Row="1">
    <TextBlock x:Name="RuntimeStatus" FontSize="12" Foreground="#999999" Margin="10,0,0,8" TextWrapping="Wrap" Visibility="Collapsed"/>
    <Expander Header="Card details" Foreground="#999999" FontSize="12" Margin="0,0,0,8"><StackPanel Margin="8,8"><TextBlock x:Name="ResourceInfo" TextWrapping="Wrap"/><TextBlock x:Name="ThermalStatus" TextWrapping="Wrap"/><TextBlock x:Name="MemoryStatus" TextWrapping="Wrap"/><TextBlock x:Name="Forecast" Text="Automatic resources" TextWrapping="Wrap"/><TextBlock x:Name="LoadStatus" TextWrapping="Wrap"/><WrapPanel Margin="0,8,0,0"><Button x:Name="Restore" Content="Restore runtime"/><Button x:Name="Evidence" Content="Open evidence" Background="Transparent"/></WrapPanel></StackPanel></Expander>
    <Border x:Name="StatisticsPanel" Visibility="Collapsed" Background="#292929" CornerRadius="14" Padding="18,12" Margin="0,0,0,8" MaxWidth="800">
     <StackPanel><TextBlock x:Name="StatsState" Text="No response yet" Foreground="#B7CBC4" FontSize="12" Margin="0,0,0,12"/>
      <UniformGrid Columns="3">
       <StackPanel Margin="0,0,8,12"><TextBlock Text="Generation" Foreground="#999999" FontSize="12"/><TextBlock x:Name="Speed" Text="--" FontSize="17" Margin="0,3,0,0"/></StackPanel>
       <StackPanel Margin="0,0,8,12"><TextBlock Text="Prompt processing" Foreground="#999999" FontSize="12"/><TextBlock x:Name="PromptSpeed" Text="--" FontSize="17" Margin="0,3,0,0"/></StackPanel>
       <StackPanel Margin="0,0,0,12"><TextBlock Text="Elapsed" Foreground="#999999" FontSize="12"/><TextBlock x:Name="StatsElapsed" Text="--" FontSize="17" Margin="0,3,0,0"/></StackPanel>
       <StackPanel><TextBlock Text="Output tokens" Foreground="#999999" FontSize="12"/><TextBlock x:Name="StatsOutput" Text="--" FontSize="17" Margin="0,3,0,0"/></StackPanel>
       <StackPanel><TextBlock Text="Prompt tokens" Foreground="#999999" FontSize="12"/><TextBlock x:Name="StatsPrompt" Text="--" FontSize="17" Margin="0,3,0,0"/></StackPanel>
       <StackPanel><TextBlock Text="Context used" Foreground="#999999" FontSize="12"/><TextBlock x:Name="StatsContext" Text="--" FontSize="17" Margin="0,3,0,0"/></StackPanel>
      </UniformGrid><TextBlock x:Name="StatsNote" Foreground="#999999" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/>
     </StackPanel>
    </Border>
   </StackPanel>
   <Grid Grid.Row="2"><ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ChatMessages" MaxWidth="800" Margin="0,16"/></ScrollViewer><TextBlock x:Name="Welcome" Text="What can I help with?" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
   <Border Grid.Row="3" Background="#303030" CornerRadius="24" Padding="18,12" MaxWidth="800" Margin="0,16,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><WrapPanel x:Name="Attachments" Grid.ColumnSpan="3" Visibility="Collapsed"/><Button x:Name="Attach" Grid.Row="1" Content="+" FontSize="26" Width="36" Height="36" Padding="0" Background="Transparent" VerticalAlignment="Bottom" Margin="0,0,8,2" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Attach images" ToolTip="Attach images"/>
    <TextBox x:Name="Input" Grid.Row="1" Grid.Column="1" MinHeight="52" MaxHeight="160" Background="Transparent" Foreground="#ECECEC" BorderThickness="0" FontSize="15" Padding="2,8" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="Message Phi Chat. Enter to send; Shift+Enter for a new line."/>
    <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Bottom" Orientation="Horizontal"><Button x:Name="Stop" Content="Stop" Visibility="Collapsed" Margin="8,0,0,0"/><Button x:Name="Send" Content="Send" Margin="8,0,0,0" Background="#ECECEC" Foreground="#212121" IsEnabled="False"/></StackPanel>
   </Grid></Border>
   <StackPanel Grid.Row="4" MaxWidth="800"><ProgressBar x:Name="LoadProgress" Minimum="0" Maximum="100" Height="3" Visibility="Collapsed" Foreground="#B8B8B8" Background="#303030" Margin="12,8"/>
    <DockPanel Margin="4,6,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button x:Name="Statistics" Content="Statistics" Background="Transparent" Foreground="#AAAAAA" Padding="10,6" ToolTip="Show live statistics for this chat"/>
     <Button x:Name="ContextUsage" Background="Transparent" Padding="4,0" AutomationProperties.Name="Context usage" ToolTip="Context usage"><StackPanel Orientation="Horizontal"><Grid Width="32" Height="32"><Ellipse Width="22" Height="22" Stroke="#4A4A4A" StrokeThickness="3"/><Path x:Name="ContextArc" Stroke="#B7CBC4" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/><Ellipse x:Name="ContextFull" Width="22" Height="22" Stroke="#B7CBC4" StrokeThickness="3" Visibility="Collapsed"/></Grid><TextBlock x:Name="ContextLabel" Text="--" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center" Margin="2,0,4,0"/></StackPanel></Button>
    </StackPanel><TextBlock x:Name="Status" Text="Connecting to Xeon Phi..." Foreground="#999999" FontSize="12" Margin="6,6,10,0" TextWrapping="Wrap"/></DockPanel>
   </StackPanel>
   <TextBox x:Name="Transcript" Visibility="Collapsed"/>
   <Border x:Name="DropOverlay" Grid.RowSpan="5" Background="#EE212121" BorderBrush="#888888" BorderThickness="2" CornerRadius="24" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="10"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="+" FontSize="52" HorizontalAlignment="Center"/><TextBlock Text="Drop images here" FontSize="24" FontWeight="SemiBold" Margin="0,16,0,8"/><TextBlock Text="Add them to your message" Foreground="#AAAAAA" HorizontalAlignment="Center"/></StackPanel></Border>
  </Grid>
 </Grid>
</Window>
